# =====================================================================
# CRIME OS AI — CENTRAL ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. DEMO SAFETY vs STRICT DEBUGGING MODE
ENABLE_DEMO_FALLBACKS=false
DEBUG=true

# 2. LLM API KEYS (Polyglot LLM Factory)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# 3. HUGGINGFACE TOKEN (Optional - removes HF Hub unauthenticated warnings & increases rate limits)
HF_TOKEN=

# 4. VECTOR STORE & DATABASE CONFIGURATION
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=police_sops_v2
DATABASE_URL=postgresql://crimeos_user:crimeos_password@localhost:5432/crimeos_db
REDIS_HOST=localhost
REDIS_PORT=6379

# 5. API GATEWAY & AUTHENTICATION
PORT=4000
JWT_SECRET=crimeos_secret_jwt_key_2026_investigation_suite
AI_SERVICE_URL=http://localhost:8000
MOCK_APIS_URL=http://localhost:5000

# 6. EMAIL DISPATCH SYSTEM (Nodemailer / SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 7. SUPABASE FREE CLOUD STORAGE (Option A Selected Choice)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
